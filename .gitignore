# Hiking Project - Consolidated .gitignore
# Frontend (Saka) and Backend (SakaSaLikod) ignore rules

# ===== COMMON =====
# dependencies
node_modules/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# IDE
.vscode/settings.json
.idea/

# ===== FRONTEND (Saka) =====
# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# generated native folders
/ios
/android

app-example

# ===== BACKEND (SakaSaLikod) =====
# Node.js specific
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.production

# Database backups
*.db.backup
*.bak
