{
  "expo": {
    "name": "Saka",
    "slug": "saka",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "saka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourname.saka",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAI-xnvFzV-h5lEFs9bUNn-muw-vb4HpK8"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to track hiking progress and ensure your safety on trails.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need continuous location access to provide real-time safety monitoring and emergency assistance.",
        "NSLocationAlwaysUsageDescription": "We need continuous location access for background safety tracking.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAI-xnvFzV-h5lEFs9bUNn-muw-vb4HpK8"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.Sweetcorn.saka"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "WEATHER_API_KEY": "8354d134719c19d5c918ac8a014dc925",
      "API_HOST": "192.168.18.10",
      "router": {},
      "eas": {
        "projectId": "8a6ec809-8bee-4178-9ab4-627aea1b7445"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E6A42B",
          "defaultChannel": "safety"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080B14",
          "dark": {
            "backgroundColor": "#080B14"
          }
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
